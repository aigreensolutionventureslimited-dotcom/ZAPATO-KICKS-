    <!-- LOGLOGIC APP ENGINE JAVASCRIPT -->
    <script>
        // Raw Data Mock State Matrix
        const PRODUCTS = [
            { id: 'mre-1', category: 'mre', name: 'Alpha Combat MRE Allotment', desc: 'Case of 24 fortified high-calorie shelf-stable complete daily field menus.', price: 550, calories: '86,400 Total Cal' },
            { id: 'mre-2', category: 'mre', name: 'Desert Recon Extended Kit', desc: 'Sustained endurance ration block pack optimizing weight and electrolyte density.', price: 890, calories: '144,000 Total Cal' },
            { id: 'cat-1', category: 'catering', name: 'Platoon Hot Smokehouse Trough', desc: 'Slow-cooked beef brisket, pulled pork spreads, corn bread allotments for 40 soldiers.', price: 1250, calories: 'Hot Mess Delivery' },
            { id: 'cat-2', category: 'catering', name: 'Company Heavy Assault Buffet', desc: 'Full high-protein comfort carb loading tray sets complete with portable warming fuel.', price: 2450, calories: 'Feeds Up To 90' },
            { id: 'fit-1', category: 'fitness', name: 'Tactical Athlete Lean Bulk', desc: 'Macro-counted vacuum-packed grass-fed clean sirloin, rice, greens setup.', price: 750, calories: 'High Protein / Lean' },
            { id: 'fit-2', category: 'fitness', name: 'Iron Core Operator Special', desc: 'Custom high-density performance body composition food packs for extreme output environments.', price: 1400, calories: 'Optimal Performance' },
            { id: 'off-1', category: 'officer', name: 'Commanding Officer Reserve Ribeye', desc: 'Dry-aged premium cuts, signature char spreads, gourmet side provisions.', price: 1100, calories: 'VIP Mess Hall' },
            { id: 'off-2', category: 'officer', name: 'Joint Chiefs Gala Banquet Pack', desc: 'Highest standard dining tier designed for strategic assembly award dinners.', price: 2150, calories: 'Premium Fine Dining' },
        ];

        let cart = {};
        const btcExchangeRate = 64500; // Mock rate setting
        let countdownInterval;

        // Initialize App UI
        document.addEventListener('DOMContentLoaded', () => {
            renderProducts(PRODUCTS);
            lucide.createIcons();
        });

        function renderProducts(items) {
            const container = document.getElementById('products-container');
            container.innerHTML = '';
            
            items.forEach(p => {
                const card = document.createElement('div');
                card.className = "bg-tactical-800 border border-tactical-700 p-5 rounded-sm flex flex-col justify-between hover:border-tactical-green transition relative group";
                card.innerHTML = `
                    <div>
                        <div class="flex justify-between items-start mb-3">
                            <span class="text-[10px] font-mono tracking-widest text-tactical-gold uppercase bg-tactical-700 px-2 py-0.5 rounded-sm">${p.category} MATERIEL</span>
                            <span class="text-xs font-mono text-gray-400 flex items-center"><i data-lucide="zap" class="w-3 h-3 mr-1 text-tactical-gold"></i>${p.calories}</span>
                        </div>
                        <h4 class="text-lg font-bold text-white uppercase tracking-tight group-hover:text-tactical-gold transition duration-200">${p.name}</h4>
                        <p class="text-sm text-gray-400 mt-2 leading-relaxed">${p.desc}</p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-tactical-700 flex items-center justify-between">
                        <div>
                            <span class="text-[10px] text-gray-500 block uppercase font-mono tracking-wider">UNIT LOG COST</span>
                            <span class="text-xl font-bold font-mono text-white">$${p.price.toLocaleString()}</span>
                        </div>
                        <button onclick="addToCart('${p.id}')" class="px-3 py-2 bg-tactical-700 hover:bg-tactical-gold hover:text-tactical-900 border border-tactical-600 font-mono text-xs tracking-wider font-bold uppercase rounded-sm text-white transition flex items-center space-x-1.5">
                            <i data-lucide="plus" class="w-3.5 h-3.5"></i>
                            <span>ADD TO MANIFEST</span>
                        </button>
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
        }

        // Category Menu Filter Logic
        function filterCategory(cat) {
            document.querySelectorAll('.cat-btn').forEach(btn => {
                btn.className = "cat-btn px-4 py-2 bg-tactical-800 border border-tactical-700 text-gray-300 text-xs font-mono tracking-wider uppercase rounded-sm hover:border-tactical-gold transition";
            });
            
            const selectedBtn = document.getElementById(`cat-${cat}`);
            if (selectedBtn) {
                selectedBtn.className = "cat-btn px-4 py-2 bg-tactical-gold text-tactical-900 text-xs font-mono tracking-wider uppercase rounded-sm transition font-bold";
            }

            if (cat === 'all') {
                renderProducts(PRODUCTS);
            } else {
                const filtered = PRODUCTS.filter(p => p.category === cat);
                renderProducts(filtered);
            }
        }

        // Sidebar Controller Functions
        function toggleCart() {
            const sidebar = document.getElementById('cart-sidebar');
            sidebar.classList.toggle('hidden');
            sidebar.classList.toggle('translate-x-full');
        }

        function addToCart(id) {
            if (cart[id]) {
                cart[id]++;
            } else {
                cart[id] = 1;
            }
            updateCartState();
            // Automatically open cart to show response feedback
            const sidebar = document.getElementById('cart-sidebar');
            if (sidebar.classList.contains('hidden')) {
                toggleCart();
            }
        }

        function changeQty(id, delta) {
            if (!cart[id]) return;
            cart[id] += delta;
            if (cart[id] <= 0) delete cart[id];
            updateCartState();
        }

        // State Validation Guardrails Engine
        function updateCartState() {
            const itemsContainer = document.getElementById('cart-items-container');
            const totalDisplay = document.getElementById('cart-total-display');
            const warningBanner = document.getElementById('validation-warning');
            const checkoutCta = document.getElementById('checkout-cta');
            const badge = document.getElementById('cart-count-badge');
            
            itemsContainer.innerHTML = '';
            let total = 0;
            let count = 0;

            Object.keys(cart).forEach(id => {
                const product = PRODUCTS.find(p => p.id === id);
                if (!product) return;
                
                const itemCost = product.price * cart[id];
                total += itemCost;
                count += cart[id];

                const row = document.createElement('div');
                row.className = "p-3 bg-tactical-900 border border-tactical-700 rounded-sm flex items-center justify-between";
                row.innerHTML = `
                    <div class="max-w-[65%]">
                        <span class="text-xs font-bold text-white uppercase block truncate">${product.name}</span>
                        <span class="text-xs font-mono text-tactical-gold">$${product.price} each</span>
                    </div>
                    <div class="flex items-center space-x-2.5">
                        <div class="flex items-center border border-tactical-700 rounded-sm overflow-hidden bg-tactical-800">
                            <button onclick="changeQty('${id}', -1)" class="px-2 py-0.5 text-gray-400 hover:text-white bg-tactical-700 text-xs">-</button>
                            <span class="px-3 text-xs font-mono text-white">${cart[id]}</span>
                            <button onclick="changeQty('${id}', 1)" class="px-2 py-0.5 text-gray-400 hover:text-white bg-tactical-700 text-xs">+</button>
                        </div>
                        <span class="text-sm font-mono font-medium text-white min-w-[55px] text-right">$${itemCost}</span>
                    </div>
                `;
                itemsContainer.appendChild(row);
            });

            // Badge visibility
            if(count > 0) {
                badge.innerText = count;
                badge.classList.remove('hidden');
            } else {
                badge.classList.add('hidden');
            }

            totalDisplay.innerText = `$${total.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;

            // Bound Rules Validation checks
            if (total === 0) {
                warningBanner.className = "hidden";
                checkoutCta.disabled = true;
                checkoutCta.className = "w-full py-3 bg-gray-700 text-gray-400 cursor-not-allowed font-mono tracking-widest text-xs uppercase rounded-sm font-bold flex items-center justify-center space-x-2";
                checkoutCta.innerHTML = `<i data-lucide="lock" class="w-4 h-4"></i><span>MANIFEST VACANT</span>`;
            } else if (total < 500) {
                warningBanner.className = "p-3 bg-red-950 border border-red-700 text-red-400 text-xs font-mono rounded-sm flex items-start space-x-2";
                warningBanner.innerHTML = `<i data-lucide="alert-triangle" class="w-4 h-4 flex-shrink-0 mt-0.5"></i><span>VALIDATION ERROR: Target threshold missed. Minimum order block allowed is $500.00. Add $${(500 - total).toLocaleString()} more value.</span>`;
                checkoutCta.disabled = true;
                checkoutCta.className = "w-full py-3 bg-red-900 bg-opacity-20 text-red-400 border border-red-800 border-opacity-40 cursor-not-allowed font-mono tracking-widest text-xs uppercase rounded-sm font-bold flex items-center justify-center space-x-2";
                checkoutCta.innerHTML = `<i data-lucide="lock" class="w-4 h-4"></i><span>BELOW MINIMUM ALLOWABLE</span>`;
            } else if (total > 2500) {
                warningBanner.className = "p-3 bg-red-950 border border-red-700 text-red-400 text-xs font-mono rounded-sm flex items-start space-x-2";
                warningBanner.innerHTML = `<i data-lucide="alert-triangle" class="w-4 h-4 flex-shrink-0 mt-0.5"></i><span>VALIDATION ERROR: Logistics ceiling burst. Maximum bulk allotment cap is $2,500.00. Reduce order footprint by $${(total - 2500).toLocaleString()}.</span>`;
                checkoutCta.disabled = true;
                checkoutCta.className = "w-full py-3 bg-red-900 bg-opacity-20 text-red-400 border border-red-800 border-opacity-40 cursor-not-allowed font-mono tracking-widest text-xs uppercase rounded-sm font-bold flex items-center justify-center space-x-2";
                checkoutCta.innerHTML = `<i data-lucide="lock" class="w-4 h-4"></i><span>CEILING OVERFLOW</span>`;
            } else {
                warningBanner.className = "p-3 bg-tactical-700 border border-tactical-green text-gray-200 text-xs font-mono rounded-sm flex items-start space-x-2";
                warningBanner.innerHTML = `<i data-lucide="check-circle" class="w-4 h-4 flex-shrink-0 text-tactical-gold mt-0.5"></i><span>MANIFEST VALIDATED: Pricing complies perfectly with provisioning operational guardrails ($500 - $2500).</span>`;
                checkoutCta.disabled = false;
                checkoutCta.className = "w-full py-3 bg-tactical-gold text-tactical-900 hover:bg-opacity-90 font-mono tracking-widest text-xs uppercase rounded-sm font-bold transition flex items-center justify-center space-x-2 cursor-pointer";
                checkoutCta.innerHTML = `<i data-lucide="unlock" class="w-4 h-4"></i><span>SECURE INTEL ROUTE ORDER</span>`;
            }
            lucide.createIcons();
        }

        // Crypto Inbound Checkout Modal Handlers
        function calculateCartTotal() {
            let total = 0;
            Object.keys(cart).forEach(id => {
                const product = PRODUCTS.find(p => p.id === id);
                if (product) total += product.price * cart[id];
            });
            return total;
        }

        function openCheckoutModal() {
            const usdTotal = calculateCartTotal();
            const btcTotal = (usdTotal / btcExchangeRate).toFixed(8);

            document.getElementById('modal-usd-amount').innerText = `= $${usdTotal.toLocaleString(undefined, {minimumFractionDigits: 2})} USD`;
            document.getElementById('modal-btc-amount').innerText = `${btcTotal} BTC`;
            
            document.getElementById('payment-pending-screen').classList.remove('hidden');
            document.getElementById('payment-success-screen').classList.add('hidden');
            document.getElementById('checkout-modal').classList.remove('hidden');
            
            startCountdown();
        }

        function closeCheckoutModal() {
            document.getElementById('checkout-modal').classList.add('hidden');
            clearInterval(countdownInterval);
        }

        function startCountdown() {
            clearInterval(countdownInterval);
            let timeRemaining = 15 * 60; // 15 mins down clock
            const display = document.getElementById('countdown-timer');
            
            countdownInterval = setInterval(() => {
                let minutes = Math.floor(timeRemaining / 60);
                let seconds = timeRemaining % 60;
                minutes = minutes < 10 ? '0' + minutes : minutes;
                seconds = seconds < 10 ? '0' + seconds : seconds;
                
                display.innerText = `${minutes}:${seconds}`;
                
                if (--timeRemaining < 0) {
                    clearInterval(countdownInterval);
                    display.innerText = "EXPIRED";
                    alert("Exchange rate lock window timed out. Please reinitalize checkout transmission routing.");
                    closeCheckoutModal();
                }
            }, 1000);
        }

        function copyAddress() {
            const addressInput = document.getElementById('wallet-address');
            addressInput.select();
            addressInput.setSelectionRange(0, 99999); /* For mobile screen boundaries compatibility */
            navigator.clipboard.writeText(addressInput.value);

            const icon = document.getElementById('copy-icon');
            icon.setAttribute('data-lucide', 'check');
            lucide.createIcons();
            
            setTimeout(() => {
                icon.setAttribute('data-lucide', 'copy');
                lucide.createIcons();
            }, 2000);
        }

        function simulateBlockchainValidation() {
            const verifyBtn = document.querySelector('[onclick="simulateBlockchainValidation()"]');
            verifyBtn.disabled = true;
            verifyBtn.innerHTML = `<svg class="animate-spin h-4 w-4 text-tactical-900" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg><span>QUERYING CHAIN...</span>`;

            setTimeout(() => {
                document.getElementById('payment-pending-screen').classList.add('hidden');
                document.getElementById('payment-success-screen').classList.remove('hidden');
                clearInterval(countdownInterval);
                
                // Restoring button layout state frame internally
                verifyBtn.disabled = false;
                verifyBtn.innerHTML = `<i data-lucide="cpu" class="w-4 h-4"></i><span>VERIFY MEMPOOL</span>`;
                lucide.createIcons();
            }, 2500); // 2.5 seconds artificial mempool checking bounce
        }

        function resetCartAndClose() {
            cart = {};
            updateCartState();
            closeCheckoutModal();
            const sidebar = document.getElementById('cart-sidebar');
            if (!sidebar.classList.contains('hidden')) {
                toggleCart();
            }
        }
    </script>
</body>
</html>
